; Engine configuration file.
; Pinned engine: Godot 4.7.2 stable (see docs/DECISIONS.md).

config_version=5

[application]

config/name="ROCKET BREAKERS"
config/description="Break it. Tow it. Make it yours."
config/version="0.1.0-m0"
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=1
