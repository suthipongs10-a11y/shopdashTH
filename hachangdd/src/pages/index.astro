---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaButtons from '@/components/CtaButtons.astro';
import Icons from '@/components/Icons.astro';
import { contact, provinces, services, site } from '@/data/site';

// M1: หน้าแรกชั่วคราว — พิสูจน์ว่า data + layout + CTA ทำงาน
// หน้าแรกตัวจริง (hero, บริการ, บทความแนะนำ) ทำใน M3
const service = services[0]!;
---

<BaseLayout
  title={`${site.name} — ${service.nameTh}ถึงบ้าน ${site.tagline}`}
  description={site.description}
>
  <section class="bg-brand-900 text-white">
    <div class="container-page py-12 sm:py-16">
      <h1 class="text-3xl font-extrabold sm:text-4xl">
        {service.nameTh}ถึงบ้าน — {service.tagline}
      </h1>
      <p class="mt-4 max-w-2xl text-brand-100">{service.intro}</p>
      <CtaButtons class="mt-6 max-w-lg" />
      <p class="mt-3 text-sm text-brand-200">{contact.hoursTh}</p>
    </div>
  </section>

  <section class="container-page py-10">
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        service.trustBullets.map((b) => (
          <li class="flex items-start gap-2 rounded-xl bg-brand-50 p-4 text-ink-700">
            <Icons name="check" class="mt-1 h-5 w-5 shrink-0 text-brand-600" />
            <span>{b}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    provinces.map((province) => (
      <section class="container-page pb-12">
        <h2 class="text-2xl font-extrabold text-brand-900">
          {service.nameTh}จังหวัด{province.nameTh}
        </h2>
        <p class="mt-2 max-w-2xl text-ink-700">{province.intro}</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {province.districts.map((d) => (
            <li>
              <a
                href={`/${service.slug}/${province.slug}/${d.slug}/`}
                class="flex h-full items-start gap-2 rounded-xl border border-gray-200 p-4 hover:border-brand-500 hover:bg-brand-50"
              >
                <Icons name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" />
                <span>
                  <span class="block font-bold text-brand-900">
                    {service.nameTh}
                    {d.nameTh}
                  </span>
                  <span class="mt-1 block text-sm text-ink-500">{d.areas.slice(0, 4).join(' · ')}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
