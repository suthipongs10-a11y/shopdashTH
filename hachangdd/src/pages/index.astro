---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import TrustBar from '@/components/TrustBar.astro';
import PriceTable from '@/components/PriceTable.astro';
import StepsTimeline from '@/components/StepsTimeline.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import LinkGrid from '@/components/LinkGrid.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import ReviewsSection from '@/components/ReviewsSection.astro';
import Icons from '@/components/Icons.astro';
import { districtPath, provincePath, provinces, servicePath, services, site } from '@/data/site';
import { aggregateFor, reviewsFor } from '@/data/reviews';
import { getFeaturedPosts, postPath } from '@/lib/blog';
import {
  breadcrumbNode,
  clampDescription,
  faqNode,
  graph,
  orgNode,
  serviceNode,
  webPageNode,
  websiteNode,
  type Crumb,
} from '@/lib/seo';

const service = services[0]!;
const province = provinces[0]!;
const path = '/';

const title = `${site.name} — ${service.nameTh}ถึงบ้าน ${province.nameTh} ราคาเริ่ม ${service.priceFrom} บาท`;
const description = clampDescription(site.description);

const crumbs: Crumb[] = [{ name: 'หน้าแรก', path: '/' }];

const scope = { serviceSlug: service.slug };
const schema = graph([
  orgNode(),
  websiteNode(),
  webPageNode({ title, description, path }, { hasBreadcrumb: true }),
  breadcrumbNode(path, crumbs),
  serviceNode({ path, service }),
  faqNode(path, service.faqs.slice(0, 4)),
]);

const posts = await getFeaturedPosts(3);
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <Hero
    title={`${service.nameTh}ถึงบ้านใน${province.nameTh} — ช่างในพื้นที่ ราคาบอกก่อนทำ`}
    lead={`ทักมาบอกจำนวนเครื่องกับอำเภอของคุณ เราแจ้งราคาให้ก่อน นัดวันที่สะดวก ช่างเข้าไปทำถึงบ้าน จ่ายเงินหลังงานเสร็จ ให้บริการ ${province.districts.length} อำเภอทั่วจังหวัด${province.nameTh}`}
    chips={[
      `เริ่ม ${service.priceFrom} บาท`,
      'แจ้งราคาก่อนทำ',
      'ช่างอยู่ในพื้นที่',
      'ไม่มีค่ามัดจำ',
    ]}
  />

  <Section tone="white">
    <TrustBar items={service.trustBullets} />
  </Section>

  <Section
    tone="tint"
    id="areas"
    title={`${service.nameTh}จังหวัด${province.nameTh}`}
    lead={province.intro}
  >
    <LinkGrid
      items={province.districts.map((d) => ({
        href: districtPath(service.slug, province.slug, d.slug),
        title: `${service.nameTh}${d.nameTh}`,
        sub: d.areas.slice(0, 4).join(' · '),
      }))}
    />
    <p class="mt-5">
      <a
        href={provincePath(service.slug, province.slug)}
        class="inline-flex items-center gap-1.5 font-bold text-brand-700 hover:underline"
      >
        ดูภาพรวมทั้งจังหวัด{province.nameTh}
        <Icons name="arrow" class="h-4 w-4" />
      </a>
    </p>
  </Section>

  <Section
    tone="white"
    id="price"
    title={`ราคา${service.nameTh}`}
    lead="ราคาเดียวกันทุกอำเภอ ไม่มีค่าเดินทางแอบแฝง"
  >
    <PriceTable service={service} />
    <p class="mt-4">
      <a
        href={servicePath(service.slug)}
        class="inline-flex items-center gap-1.5 font-bold text-brand-700 hover:underline"
      >
        ดูรายละเอียดบริการ{service.nameTh}ทั้งหมด
        <Icons name="arrow" class="h-4 w-4" />
      </a>
    </p>
  </Section>

  <Section tone="tint" id="steps" title="ใช้บริการยังไง" lead="4 ขั้นตอน ไม่ยุ่งยาก">
    <StepsTimeline steps={service.steps} />
  </Section>

  <ReviewsSection
    reviews={reviewsFor({ ...scope, limit: 3 })}
    aggregate={aggregateFor(scope)}
    title="รีวิวจากลูกค้า"
    tone="white"
  />

  <CtaBanner
    title="โทรหรือทัก LINE ได้เลย"
    lead="แจ้งราคาก่อนทำทุกครั้ง ถ้าไม่โอเคไม่ต้องทำ ไม่มีค่าใช้จ่าย"
    place="home-mid"
  />

  <Section tone="tint" id="faq" title="คำถามที่พบบ่อย">
    <FaqAccordion faqs={service.faqs.slice(0, 4)} />
    <p class="mt-5">
      <a
        href={`${servicePath(service.slug)}#faq`}
        class="inline-flex items-center gap-1.5 font-bold text-brand-700 hover:underline"
      >
        ดูคำถามทั้งหมด
        <Icons name="arrow" class="h-4 w-4" />
      </a>
    </p>
  </Section>

  <Section tone="white" id="articles" title="บทความและคำแนะนำ">
    <LinkGrid
      icon="quote"
      items={posts.map((p) => ({ href: postPath(p), title: p.data.title, sub: p.data.excerpt }))}
    />
  </Section>
</BaseLayout>
