---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyCta from '@/components/StickyCta.astro';
import { site } from '@/data/site';
import { abs } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  /** path ของหน้านี้ เช่น "/lang-air/ubon-ratchathani/" — ใช้ทำ canonical + og:url */
  path: string;
  /** JSON-LD ก้อนเดียวแบบ @graph (สร้างจาก lib/seo.ts) */
  schema?: unknown;
  noindex?: boolean;
  /** ข้ามหน้านี้ตอนสร้าง sitemap เช่นหน้า 404 */
  ogImage?: string;
}

const { title, description, path, schema, noindex = false, ogImage } = Astro.props;

const canonical = abs(path);
const image = abs(ogImage ?? '/og-default.png');
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// Cloudflare Web Analytics — ใส่ token ผ่าน env เท่านั้น ถ้าไม่มีก็ไม่โหลดสคริปต์ใด ๆ
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" content="#082e4b" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- ฟอนต์ self-host: preload เฉพาะ subset ไทยที่ใช้จริงบนหน้าจอแรก -->
    <link
      rel="preload"
      href="/fonts/noto-sans-thai-thai.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-brand-700 focus:px-4 focus:py-2 focus:font-bold focus:text-white"
      >ข้ามไปเนื้อหาหลัก</a
    >
    <Header />
    <main id="main" class="grow">
      <slot />
    </main>
    <Footer />
    <StickyCta />

    {
      cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }
  </body>
</html>
