---
import Icons from './Icons.astro';
import type { IconName } from '@/lib/icons';

interface Props {
  items: { href: string; title: string; sub?: string }[];
  columns?: 2 | 3;
  icon?: IconName;
}
const { items, columns = 3, icon = 'pin' } = Astro.props;
---

<ul class:list={['grid gap-3', columns === 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2']}>
  {
    items.map((item) => (
      <li>
        <a
          href={item.href}
          class="card flex h-full items-start gap-3 p-4 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lift"
        >
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
            <Icons name={icon} class="h-5 w-5" />
          </span>
          <span class="min-w-0">
            <span class="block font-bold text-brand-900">{item.title}</span>
            {item.sub && <span class="mt-0.5 block text-sm text-ink-500">{item.sub}</span>}
          </span>
          <Icons name="arrow" class="mt-2 ml-auto h-4 w-4 shrink-0 text-brand-300" />
        </a>
      </li>
    ))
  }
</ul>
