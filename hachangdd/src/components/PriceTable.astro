---
import type { Service } from '@/data/site';
import Icons from './Icons.astro';

interface Props {
  service: Service;
  /** ใช้ในหัวตารางเพื่อให้แต่ละหน้าไม่ซ้ำกันเป๊ะ */
  areaLabel?: string;
}
const { service, areaLabel } = Astro.props;
---

<div class="card overflow-hidden">
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">
      ตารางราคา{service.nameTh}{areaLabel ?? ''}
    </caption>
    <thead>
      <tr class="bg-brand-900 text-white">
        <th scope="col" class="px-4 py-3 text-sm font-bold sm:px-5">รายการ</th>
        <th scope="col" class="px-4 py-3 text-right text-sm font-bold whitespace-nowrap sm:px-5">
          ราคา
        </th>
      </tr>
    </thead>
    <tbody>
      {
        service.priceTable.map((row, i) => (
          <tr class:list={[i % 2 === 1 && 'bg-paper-50', 'border-t border-brand-100']}>
            <th scope="row" class="px-4 py-3.5 font-semibold text-ink-800 sm:px-5">
              {row.type}
              {row.note && <span class="block text-sm font-normal text-ink-500">{row.note}</span>}
            </th>
            <td class="px-4 py-3.5 text-right font-bold whitespace-nowrap text-brand-700 sm:px-5">
              {row.price}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="mt-3 flex items-start gap-2 rounded-xl bg-brand-50 p-4 text-sm text-ink-700">
  <Icons name="shield" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" />
  <span>{service.priceNote}</span>
</p>
