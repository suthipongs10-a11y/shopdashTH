---
import { contact } from '@/data/site';
import Icons from './Icons.astro';

interface Props {
  /** ใช้บอก analytics ว่ากดมาจากส่วนไหนของหน้า */
  place: string;
  callLabel?: string;
  lineLabel?: string;
  size?: 'md' | 'lg';
  class?: string;
}
const {
  place,
  callLabel = `โทรเลย ${contact.phone}`,
  lineLabel = 'ทักไลน์ จองคิว',
  size = 'lg',
  class: className = '',
} = Astro.props;

const pad = size === 'lg' ? 'px-6 py-4 text-lg' : 'px-5 py-3';
---

<div class:list={['grid gap-3 sm:grid-cols-2', className]}>
  <a href={`tel:${contact.phoneTel}`} data-cta={`call:${place}`} class:list={['btn-call', pad]}>
    <Icons name="phone" class="h-5 w-5" />
    {callLabel}
  </a>
  <a
    href={contact.lineUrl}
    data-cta={`line:${place}`}
    rel="noopener"
    class:list={['btn-line', pad]}
  >
    <Icons name="line" class="h-6 w-6" />
    {lineLabel}
  </a>
</div>
