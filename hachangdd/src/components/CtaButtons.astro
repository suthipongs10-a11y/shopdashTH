---
import { contact } from '@/data/site';
import Icons from './Icons.astro';

interface Props {
  /** ข้อความบนปุ่มโทร ปรับตามหน้าได้ เช่น "โทรเลย 08X-XXX-XXXX" */
  callLabel?: string;
  lineLabel?: string;
  /** ปุ่มเต็มความกว้างบนมือถือ */
  size?: 'md' | 'lg';
  class?: string;
}
const {
  callLabel = `โทรเลย ${contact.phone}`,
  lineLabel = 'ทักไลน์',
  size = 'lg',
  class: className = '',
} = Astro.props;

const pad = size === 'lg' ? 'px-6 py-4 text-lg' : 'px-5 py-3 text-base';
---

<div class={`flex flex-col gap-3 sm:flex-row ${className}`}>
  <a
    href={`tel:${contact.phoneTel}`}
    data-cta="call"
    class={`btn-base ${pad} flex-1 bg-call-600 text-center whitespace-nowrap text-white shadow-lg shadow-call-600/25 hover:bg-call-700`}
  >
    <Icons name="phone" class="h-5 w-5" />
    {callLabel}
  </a>
  <a
    href={contact.lineUrl}
    data-cta="line"
    rel="noopener"
    class={`btn-base ${pad} flex-1 bg-line-500 text-center whitespace-nowrap text-white shadow-lg shadow-line-500/25 hover:bg-line-600`}
  >
    <Icons name="line" class="h-6 w-6" />
    {lineLabel}
  </a>
</div>
