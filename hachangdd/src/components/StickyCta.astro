---
import { contact } from '@/data/site';
import Icons from './Icons.astro';
---

<!-- แถบ CTA ล่างจอ เฉพาะมือถือ — ผู้ใช้ต่างจังหวัด 90%+ มาจากมือถือ -->
<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-gray-200 bg-white/95 p-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] backdrop-blur md:hidden"
>
  <div class="flex gap-2">
    <a
      href={`tel:${contact.phoneTel}`}
      data-cta="call-sticky"
      class="btn-base flex-1 bg-call-600 py-3 text-white"
    >
      <Icons name="phone" class="h-5 w-5" />โทรเลย
    </a>
    <a
      href={contact.lineUrl}
      data-cta="line-sticky"
      rel="noopener"
      class="btn-base flex-1 bg-line-500 py-3 text-white"
    >
      <Icons name="line" class="h-6 w-6" />ทักไลน์
    </a>
  </div>
</div>
<!-- เว้นที่ให้แถบ CTA ไม่บังเนื้อหาท้ายหน้า -->
<div class="h-20 md:hidden" aria-hidden="true"></div>
