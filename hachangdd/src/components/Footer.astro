---
import { contact, provinces, services, site } from '@/data/site';
import Icons from './Icons.astro';

const service = services[0]!;
const year = new Date().getFullYear();
const province = provinces[0]!;
---

<footer class="mt-auto border-t border-brand-100 bg-paper-50">
  <div class="container-page grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="flex items-center gap-2 text-lg font-extrabold text-brand-900">
        <span
          aria-hidden="true"
          class="grid h-9 w-9 place-items-center rounded-xl bg-brand-600 text-white"
        >
          <Icons name="snow" class="h-5 w-5" />
        </span>
        {site.name}
      </p>
      <p class="mt-3 text-sm text-ink-700">{site.description}</p>
      <div class="mt-4 grid gap-2 text-sm">
        <a
          href={`tel:${contact.phoneTel}`}
          data-cta="call:footer"
          class="flex items-center gap-2 font-bold text-brand-700"
        >
          <Icons name="phone" class="h-4 w-4" />
          {contact.phone}
        </a>
        <a
          href={contact.lineUrl}
          data-cta="line:footer"
          rel="noopener"
          class="flex items-center gap-2 font-bold text-brand-700"
        >
          <Icons name="line" class="h-5 w-5" />
          LINE {contact.lineOaId}
        </a>
        <p class="flex items-center gap-2 text-ink-500">
          <Icons name="clock" class="h-4 w-4" />
          {contact.hoursTh}
        </p>
      </div>
    </div>

    <nav aria-labelledby="footer-areas">
      <p id="footer-areas" class="font-bold text-brand-900">พื้นที่ให้บริการ</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        {
          province.districts.map((d) => (
            <li>
              <a class="hover:text-brand-600" href={`/${service.slug}/${province.slug}/${d.slug}/`}>
                {service.nameTh}
                {d.nameTh}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-service">
      <p id="footer-service" class="font-bold text-brand-900">บริการ</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        <li>
          <a class="hover:text-brand-600" href={`/${service.slug}/`}>{service.nameTh}ถึงบ้าน</a>
        </li>
        <li>
          <a class="hover:text-brand-600" href={`/${service.slug}/${province.slug}/`}>
            {service.nameTh}จังหวัด{province.nameTh}
          </a>
        </li>
        <li><a class="hover:text-brand-600" href="/reviews/">รีวิวจากลูกค้า</a></li>
        <li><a class="hover:text-brand-600" href="/blog/">บทความและคำแนะนำ</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-about">
      <p id="footer-about" class="font-bold text-brand-900">เกี่ยวกับเรา</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        <li><a class="hover:text-brand-600" href="/about/">เราเป็นใคร</a></li>
        <li><a class="hover:text-brand-600" href="/contact/">ติดต่อเรา</a></li>
        <li><a class="hover:text-brand-600" href="/contact/#partner">สมัครเป็นช่างพาร์ทเนอร์</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-brand-100 py-4">
    <p class="container-page text-center text-xs text-ink-500">
      {`© ${year} ${site.name} (${site.domain}) — บริการหาช่างในพื้นที่ จังหวัด${province.nameTh}`}
    </p>
  </div>
</footer>
