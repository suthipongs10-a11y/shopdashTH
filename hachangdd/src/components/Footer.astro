---
import { contact, provinces, services, site } from '@/data/site';

const service = services[0]!;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-gray-100 bg-brand-50/60">
  <div class="container-page grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="text-lg font-extrabold text-brand-900">{site.name}</p>
      <p class="mt-2 text-sm text-ink-700">{site.description}</p>
      <p class="mt-4 text-sm text-ink-700">
        โทร <a class="font-bold text-brand-700" href={`tel:${contact.phoneTel}`}>{contact.phone}</a
        ><br />
        LINE <a class="font-bold text-brand-700" href={contact.lineUrl} rel="noopener"
          >{contact.lineOaId}</a
        ><br />
        {contact.hoursTh}
      </p>
    </div>

    <div>
      <p class="font-bold text-brand-900">พื้นที่ให้บริการ</p>
      <ul class="mt-3 space-y-1.5 text-sm text-ink-700">
        {
          provinces.map((p) =>
            p.districts.map((d) => (
              <li>
                <a class="hover:text-brand-600" href={`/${service.slug}/${p.slug}/${d.slug}/`}>
                  {service.nameTh}
                  {d.nameTh}
                </a>
              </li>
            )),
          )
        }
      </ul>
    </div>

    <div>
      <p class="font-bold text-brand-900">เมนู</p>
      <ul class="mt-3 space-y-1.5 text-sm text-ink-700">
        <li><a class="hover:text-brand-600" href={`/${service.slug}/`}>{service.nameTh}</a></li>
        <li><a class="hover:text-brand-600" href="/blog/">บทความ</a></li>
        <li><a class="hover:text-brand-600" href="/about/">เกี่ยวกับเรา</a></li>
        <li><a class="hover:text-brand-600" href="/contact/">ติดต่อ / สมัครเป็นช่างพาร์ทเนอร์</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-brand-100 py-4 text-center text-xs text-ink-500">
    {`© ${year} ${site.name} (${site.domain}) — บริการหาช่างในพื้นที่`}
  </div>
</footer>
