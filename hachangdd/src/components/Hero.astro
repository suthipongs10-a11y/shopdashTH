---
import CtaButtons from './CtaButtons.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icons from './Icons.astro';
import { contact } from '@/data/site';
import type { Crumb } from '@/lib/seo';

interface Props {
  /** H1 ของหน้า — หน้าละหนึ่งตัวเท่านั้น */
  title: string;
  lead: string;
  crumbs?: Crumb[];
  /** ป้ายเล็กเหนือ H1 เช่น "อุบลราชธานี" */
  eyebrow?: string;
  /** ชิปสั้น ๆ ใต้ปุ่ม เช่น "ราคาแจ้งก่อนทำ" */
  chips?: string[];
}
const { title, lead, crumbs, eyebrow, chips = [] } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-900 text-white">
  <!-- ลายพื้นหลังแบบ CSS ล้วน ไม่มีไฟล์รูป → ไม่กระทบ LCP -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.55]"
    style="background:radial-gradient(60rem 28rem at 12% -10%, #12649f 0%, transparent 60%), radial-gradient(40rem 24rem at 95% 0%, #0e4f7f 0%, transparent 65%)"
  >
  </div>

  <div class="relative container-page py-8 sm:py-14">
    {crumbs && <Breadcrumbs crumbs={crumbs} onDark />}

    {
      eyebrow && (
        <p class="mt-5 inline-flex items-center gap-1.5 rounded-pill bg-white/10 px-3 py-1 text-sm font-semibold text-brand-100">
          <Icons name="pin" class="h-4 w-4" />
          {eyebrow}
        </p>
      )
    }

    <h1 class="mt-3 text-[1.75rem] leading-[1.35] font-extrabold text-white sm:text-4xl">
      {title}
    </h1>
    <p class="mt-3 max-w-2xl text-brand-100 sm:text-lg">{lead}</p>

    <CtaButtons place="hero" class="mt-6 max-w-xl" />

    <p class="mt-3 flex items-center gap-2 text-sm text-brand-200">
      <Icons name="clock" class="h-4 w-4" />
      {contact.hoursTh} · ไม่มีค่ามัดจำ จ่ายหลังงานเสร็จ
    </p>

    {
      chips.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {chips.map((c) => (
            <li class="flex items-center gap-1.5 rounded-pill bg-white/10 px-3 py-1.5 text-sm text-brand-100">
              <Icons name="check" class="h-4 w-4 text-brand-300" />
              {c}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
