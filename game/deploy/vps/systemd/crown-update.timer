[Unit]
Description=Check for a new Ashen Crown build every hour (never 05:00-05:59, EggPact backup/deploy window)

[Timer]
# Minute 17 of every hour except 05 (the 04:30-05:30 EggPact window: 04:17 and 06:17 are clear).
# Thai time, whatever timezone the server clock uses.
OnCalendar=*-*-* 00..04,06..23:17:00 Asia/Bangkok
RandomizedDelaySec=2min
Persistent=false

[Install]
WantedBy=timers.target
