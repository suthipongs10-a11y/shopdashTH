{
  "name": "ads-insight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Google Ads MCP server + PWA on Cloudflare Workers",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "verify": "pnpm typecheck && pnpm test && wrangler deploy --dry-run --outdir .wrangler/verify",
    "db:migrate": "wrangler d1 migrations apply ads_insight --local",
    "db:migrate:remote": "wrangler d1 migrations apply ads_insight --remote",
    "cf-typegen": "wrangler types",
    "auth:google": "tsx scripts/get-refresh-token.ts",
    "list:accounts": "tsx scripts/list-accounts.ts",
    "fields": "tsx scripts/list-fields.ts",
    "capture:fixtures": "tsx scripts/capture-fixtures.ts",
    "fixtures:synthetic": "tsx scripts/make-synthetic-fixtures.ts",
    "check:access": "tsx scripts/check-access.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  },
  "engines": {
    "node": ">=20"
  }
}
